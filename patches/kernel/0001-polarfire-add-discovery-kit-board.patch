diff --git a/src/plat/polarfire/overlay-discovery.dts b/src/plat/polarfire/overlay-discovery.dts
new file mode 100644
index 000000000..7ffcbcea9
--- /dev/null
+++ b/src/plat/polarfire/overlay-discovery.dts
@@ -0,0 +1,59 @@
+/*
+ * Copyright 2020, DornerWorks
+ * Copyright 2021, HENSOLDT Cyber
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+/*
+ * Overlay for the PolarFire SoC Discovery Kit (MPFS-DISCO-KIT), applied on
+ * top of tools/dts/mpfs_discovery.dts (the DT extracted from the running
+ * board via /sys/firmware/fdt).
+ */
+
+/*
+ * The PolarFire MSS exposes the same physical DDR through several address
+ * windows (cached low 0x8000_0000, non-cached low 0xC000_0000, cached high
+ * 0x10_0000_0000, non-cached high 0x14_0000_0000). The firmware DT carves
+ * non-overlapping slices out of these windows for Linux and its DMA pools.
+ * seL4 has no notion of aliasing, so only use the cached-low slices that
+ * Linux uses as normal RAM:
+ *   0x8000_0000 - 0x8400_0000 (64 MiB)
+ *   0x8A00_0000 - 0x9200_0000 (128 MiB)
+ * 0x8400_0000 - 0x8A00_0000 is reserved/fabric buffers and is not in any
+ * memory node anyway.
+ */
+/delete-node/ &{/memory@c4000000};
+/delete-node/ &{/memory@1022000000};
+/delete-node/ &{/memory@1412000000};
+
+/ {
+	chosen {
+		seL4,kernel-devices =
+			&{/soc/clint@2000000},
+			&{/soc/interrupt-controller@c000000};
+	};
+
+	soc {
+		/*
+		 * The board DT only lists "sifive,clint0", which hardware.yml does
+		 * not know. Use the generic string so the CLINT is treated as a
+		 * kernel device, as overlay-polarfire.dts does for the Icicle Kit.
+		 */
+		clint@2000000 {
+			compatible = "riscv,clint0";
+		};
+	};
+
+	/*
+	 * Reserve 2 MiB for SBI firmware at the start of RAM (0x80000000 -
+	 * 0x80200000), matching overlay-polarfire.dts. The board DT uses
+	 * #address-cells = <2>, #size-cells = <2> here.
+	 */
+	reserved-memory {
+		sbi@80000000 {
+			reg = <0x00 0x80000000 0x00 0x200000>;
+			no-map;
+		};
+	};
+};
