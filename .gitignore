# Build outputs and local checkouts never belong in this repository.
build-*/
cbuild/
.repo/
*.wic
*.wic.gz
*.wic.xz
*.img
*.tar.gz
# Editor/OS noise
*~
*.swp
.DS_Store
Thumbs.db
.vscode/
# Release assets (corresponding-source archive) are generated, not committed.
dist/
# Local build outputs of the Rust root task and files staged for TFTP.
rust-root-task/build/
rust-root-task/rust/target/
tftp/root/*
!tftp/root/.gitkeep
# Console logs written by scripts/usb-flash.sh and scripts/network-flash.sh.
logs/
