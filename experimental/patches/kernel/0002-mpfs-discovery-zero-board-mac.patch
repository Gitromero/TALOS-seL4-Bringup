Zero the board-unique Ethernet MAC address in the Discovery Kit DTS.

The DTS was decompiled from one physical board, so it carried that board's
MAC (Microchip OUI 00:04:a3). Neither seL4 nor sel4test uses Ethernet; the
all-zero value matches the board's second (unused) MAC node. Applies on top
of patches/kernel/0001-polarfire-add-discovery-kit-board.patch.

--- a/tools/dts/mpfs_discovery.dts
+++ b/tools/dts/mpfs_discovery.dts
@@ -567,7 +567,7 @@
 			#size-cells = <0x00>;
 			interrupt-parent = <0x09>;
 			interrupts = <0x40 0x41 0x42 0x43 0x44 0x45>;
-			local-mac-address = [00 04 a3 6d f8 11];
+			local-mac-address = [00 00 00 00 00 00];
 			clocks = <0x01 0x04 0x01 0x02 0x11>;
 			clock-names = "pclk\0hclk\0tsu_clk";
 			resets = <0x10 0x04>;
